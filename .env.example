# =====================================================================
# .env.example — MODELO de configuração (valores fictícios).
#
# Copie para .env e preencha com valores reais:   cp .env.example .env
# O arquivo .env NUNCA vai para o Git. Crie um no seu PC e outro,
# diferente, direto no servidor de produção.
# =====================================================================

# ---------- Banco de dados (PostgreSQL + pgvector) ----------
POSTGRES_DB=docsage
POSTGRES_USER=docsage
# Gere uma senha forte com:  openssl rand -base64 24
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# Note o "+psycopg" (driver psycopg 3) e o host "db" (nome do serviço no compose).
# A senha aqui deve ser IGUAL à de POSTGRES_PASSWORD acima.
DATABASE_URL=postgresql+psycopg://docsage:TROQUE_POR_UMA_SENHA_FORTE@db:5432/docsage

# ---------- Aplicação ----------
APP_ENV=development
APP_PORT=8080

# ---------- Embeddings (modelo LOCAL, gratuito) ----------
# Multilíngue, bom para português. Gera vetores de 384 dimensões.
# ATENÇÃO: se trocar o modelo, ajuste EMBEDDING_DIM e recrie o banco
# (docker compose down -v), senão o pgvector rejeita a inserção.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ---------- LLM (geração das respostas) ----------
# Crie sua chave em https://console.anthropic.com  (Settings > API Keys)
ANTHROPIC_API_KEY=sk-ant-COLE_SUA_CHAVE_AQUI
# Haiku: rápido e barato. Troque por claude-sonnet-4-6 se quiser mais qualidade.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------- Parâmetros do RAG ----------
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000      # tamanho de cada pedaço de texto, em caracteres
CHUNK_OVERLAP=150    # sobreposição entre pedaços (preserva contexto nas bordas)
TOP_K=5              # quantos trechos recuperar por pergunta

# =====================================================================
# APENAS PRODUÇÃO (usados por docker-compose.prod.yml / Caddy).
# No seu PC, pode deixar como está.
# =====================================================================
# Seu domínio (ex.: docsage.duckdns.org) — sem "https://"
DOMAIN=docsage.duckdns.org
# E-mail para avisos do Let's Encrypt sobre expiração de certificado
ACME_EMAIL=seu-email@exemplo.com
